{
  "manifest_version": 3,
  "name": "Shifu Chrome Bridge",
  "version": "0.2.0",
  "description": "一次开启后，按本机 Shifu 任务指令后台连接准确页面，最多三个；点击图标暂停或恢复。",
  "key": "",
  "minimum_chrome_version": "118",
  "permissions": ["debugger", "nativeMessaging", "storage"],
  "background": { "service_worker": "background.mjs", "type": "module" },
  "action": { "default_title": "Shifu 自动接入：点击暂停或恢复" }
}
