#!/usr/bin/env bash
# SHIFU SessionStart hook — inject engage skill into every session
#
# Hook trigger: SessionStart (fires on startup, clear, compact)
# matcher "startup|clear|compact" matches Claude Code's SessionStart event subtypes.
# CLAUDE_PLUGIN_ROOT is set by Claude Code at plugin initialization.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

engage_file="${PLUGIN_ROOT}/skills/engage/SKILL.md"
if [ ! -f "$engage_file" ]; then
  echo '{}' # Silent no-op if skill file missing
  exit 0
fi

engage_content=$(cat "$engage_file")

# Use python3 for safe JSON escaping (handles Unicode, control chars, etc.)
escape_for_json() {
  python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()), end="")' <<< "$1"
}

engage_escaped=$(escape_for_json "$engage_content")

# Remove outer quotes added by json.dumps (we embed in our own JSON string)
engage_escaped="${engage_escaped:1:${#engage_escaped}-2}"

# Read campaign state if available
campaign_hint=""
CAMPAIGN_SCRIPT="${PLUGIN_ROOT}/hooks/scripts/campaign.sh"
if [ -x "$CAMPAIGN_SCRIPT" ]; then
  campaign_json=$(CLAUDE_PLUGIN_DATA="${CLAUDE_PLUGIN_DATA:-${HOME}/.claude/plugins/data/shifu}" "$CAMPAIGN_SCRIPT" read 2>/dev/null || echo '{}')
  # Extract and JSON-escape campaign fields to prevent injection
  campaign_gear=$(echo "$campaign_json" | python3 -c 'import json,sys; d=json.load(sys.stdin); v=d.get("gear") or ""; print(json.dumps(v)[1:-1])' 2>/dev/null || echo '')
  campaign_phase=$(echo "$campaign_json" | python3 -c 'import json,sys; d=json.load(sys.stdin); v=d.get("phase") or ""; print(json.dumps(v)[1:-1])' 2>/dev/null || echo '')
  campaign_task=$(echo "$campaign_json" | python3 -c 'import json,sys; d=json.load(sys.stdin); v=d.get("task") or ""; print(json.dumps(v)[1:-1])' 2>/dev/null || echo '')
  campaign_summary=$(echo "$campaign_json" | python3 -c 'import json,sys; d=json.load(sys.stdin); v=d.get("lastSessionSummary") or ""; print(json.dumps(v)[1:-1])' 2>/dev/null || echo '')

  if [ -n "$campaign_gear" ] || [ -n "$campaign_task" ]; then
    campaign_hint="\\n\\n## Previous Campaign State"
    [ -n "$campaign_gear" ] && campaign_hint="${campaign_hint}\\n- Gear: ${campaign_gear}"
    [ -n "$campaign_phase" ] && campaign_hint="${campaign_hint}\\n- Phase: ${campaign_phase}"
    [ -n "$campaign_task" ] && campaign_hint="${campaign_hint}\\n- Task: ${campaign_task}"
    [ -n "$campaign_summary" ] && campaign_hint="${campaign_hint}\\n- Last session: ${campaign_summary}"
    campaign_hint="${campaign_hint}\\n\\nResume or reset as appropriate. Use shifu:engage to confirm gear."
  fi

  # Queue hint — show if there are queued tasks
  queue_count=$(echo "$campaign_json" | python3 -c \
    'import json,sys; d=json.load(sys.stdin); print(len([t for t in d.get("queue",[]) if t.get("status")=="queued"]))' \
    2>/dev/null || echo '0')
  if [ "$queue_count" -gt 0 ]; then
    next_id=$(echo "$campaign_json" | python3 -c \
      'import json,sys; d=json.load(sys.stdin); q=[t for t in d.get("queue",[]) if t.get("status")=="queued"]; print(q[0]["id"] if q else "")' \
      2>/dev/null || echo '')
    next_title=$(echo "$campaign_json" | python3 -c \
      'import json,sys; d=json.load(sys.stdin); q=[t for t in d.get("queue",[]) if t.get("status")=="queued"]; print(q[0]["title"] if q else "")' \
      2>/dev/null || echo '')
    next_gear=$(echo "$campaign_json" | python3 -c \
      'import json,sys; d=json.load(sys.stdin); q=[t for t in d.get("queue",[]) if t.get("status")=="queued"]; print(q[0]["gear"] if q else "")' \
      2>/dev/null || echo '')
    if [ -z "$campaign_task" ]; then
      campaign_hint="${campaign_hint}\\n\\n## Task Queue (${queue_count} queued)"
      campaign_hint="${campaign_hint}\\nNext: #${next_id} [${next_gear}] ${next_title}"
      campaign_hint="${campaign_hint}\\nNo active task — say 'start' to claim it, or pick a different task."
    else
      campaign_hint="${campaign_hint}\\n\\n## Task Queue (${queue_count} more queued after current)"
    fi
  fi
fi

# Load accumulated learnings (compact index only — full files loaded on demand)
learnings_hint=""
LEARN_DIR="${CLAUDE_PLUGIN_DATA:-${HOME}/.claude/plugins/data/shifu}/learnings"
if [ -d "$LEARN_DIR" ]; then
  learning_files=$(ls "$LEARN_DIR"/*.md 2>/dev/null || true)
  if [ -n "$learning_files" ]; then
    # Build a compact index: filename + first line (pattern name)
    learnings_index=""
    for f in $learning_files; do
      fname=$(basename "$f" .md)
      first_line=$(head -1 "$f" | sed 's/^# //')
      learnings_index="${learnings_index}\\n- ${fname}: ${first_line}"
    done
    learnings_count=$(echo "$learning_files" | wc -w | tr -d ' ')
    learnings_hint="\\n\\n## Accumulated Learnings (${learnings_count} patterns)"
    learnings_hint="${learnings_hint}${learnings_index}"
    learnings_hint="${learnings_hint}\\n\\nTo load a specific learning: cat ${LEARN_DIR}/<name>.md"
  fi
fi

# Context budget — prevent hint bloat from crowding out code context
# Priority: engage (mandatory) > campaign > learnings
BUDGET=12000  # ~3000 tokens; leaves room for engage plus bounded state hints

_trim_hints() {
  local total_len=$((${#engage_escaped} + ${#campaign_hint} + ${#learnings_hint}))
  if [ "$total_len" -le "$BUDGET" ]; then
    return
  fi
  if [ "$total_len" -gt "$BUDGET" ] && [ -n "$learnings_hint" ]; then
    learnings_hint=""
    total_len=$((${#engage_escaped} + ${#campaign_hint} + ${#learnings_hint}))
    echo "shifu:context_trim: learnings_hint (budget)" >&2
  fi
  if [ "$total_len" -gt "$BUDGET" ] && [ -n "$campaign_hint" ]; then
    campaign_hint=""
    total_len=$((${#engage_escaped} + ${#campaign_hint} + ${#learnings_hint}))
    echo "shifu:context_trim: campaign_hint (budget)" >&2
  fi
  echo "shifu:context_budget: ${total_len}/${BUDGET} chars after trim" >&2
}

_trim_hints

session_context="<SHIFU>\\nYou have SHIFU installed — an adaptive discipline system.\\n\\nContext discipline: load skills on-demand, keep active context minimal. See shifu:context for details.${campaign_hint}${learnings_hint}\\n\\n**Below is your shifu:engage skill. For all other skills, use the Skill tool:**\\n\\n${engage_escaped}\\n</SHIFU>"

# Platform-specific JSON output format:
# - Cursor: additional_context (snake_case)
# - Claude Code: hookSpecificOutput.additionalContext (nested)
# - Copilot CLI / others: additionalContext (SDK standard)
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context"
fi

exit 0
