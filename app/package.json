{
  "name": "shifu-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "python3 ../scripts/build-cache.py run --kind desktop -- tauri build",
    "build:remote": "bash ../scripts/build-remote-crypto.sh && tsc --noEmit --project remote/tsconfig.json && vite build --config vite.remote.config.ts",
    "tauri": "tauri",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dockview": "^8.8.3",
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.1.0"
  },
  "license": "MIT"
}
